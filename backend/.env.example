# Backend service port. DigitalOcean App Platform injects PORT automatically.
PORT=3001

# Required auth secret. Use a long random value in production.
JWT_SECRET=change_me_to_a_long_random_secret

# Required MySQL config
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=intern_tracker

# Optional frontend origin. Use your production frontend URL on DigitalOcean/Vercel.
FRONTEND_ORIGIN=http://localhost:5173

# LLM service config
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini

# Optional OCR service config
OCR_API_URL=
OCR_API_KEY=
